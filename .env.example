# ---------------------------------------------------------------------------
# Required. Without these nothing persists.
# ---------------------------------------------------------------------------

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Shared password for the whole team. Minimum 8 characters; an unset or shorter
# value denies everyone, so a deploy that forgets it is closed, not open.
# Changing it signs every existing session out, which is how you revoke access.
DASHBOARD_PASSWORD=

# Supabase dashboard > Project Settings > API Keys > service_role.
# Bypasses row level security. Server side only, never exposed to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Bearer token the cron routes require. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
CRON_SECRET=

# Bearer token for /api/ingest/*, where the app's own backend pushes figures no
# store API can report: DAU, WAU and MAU. Generate the same way as CRON_SECRET,
# and keep it separate so the app team holds a key that can only write counts.
# Unset closes the endpoint rather than opening it. See
# docs/active-users-ingest.md for the contract to hand the backend developer.
INGEST_SECRET=

# ---------------------------------------------------------------------------
# Optional: App Store Connect. Without these the dashboard still collects
# rank, ratings, reviews, keywords and Play installs; only iOS download
# numbers are unavailable, and the UI says so rather than showing zero.
# ---------------------------------------------------------------------------

# App Store Connect > Users and Access > Integrations > App Store Connect API.
# Create a Team Key with the "Sales and Reports" role, which is the least
# privilege that covers both sales reports and analytics. Note that a key
# cannot be granted more services after it is created.
ASC_KEY_ID=
ASC_ISSUER_ID=

# App Store Connect > Business > Payments and Financial Reports. Usually 8 digits.
ASC_VENDOR_NUMBER=

# The ongoing Analytics report request, for download source attribution.
# Create it once and keep the id:
#   POST /v1/analyticsReportRequests {accessType: ONGOING, app: <id>}
# Apple generates nothing until this exists and then only going forward, so
# make the request early even if the collector is wired later.
ASC_ANALYTICS_REQUEST_ID=

# The .p8 file, base64 encoded onto one line:
#   base64 -i AuthKey_XXXXXXXXXX.p8 | tr -d '\n'
# This is the private key itself and downloads exactly once, at creation.
# It is NOT the Key ID, and NOT a .certSigningRequest.
ASC_PRIVATE_KEY_B64=

# ---------------------------------------------------------------------------
# Optional: UstozAI's own admin API. Without it the dashboard still reports
# everything the stores publish; only the product and business figures are
# unavailable, and the UI says so rather than showing zero.
# ---------------------------------------------------------------------------

# The only source for anything about the app itself rather than the store
# pages around it: revenue, MRR, subscriptions, registered and active users,
# time spent, and where students drop out of a lesson. No store API reports
# any of these.
#
# Base URL without a trailing slash and without the version segment; the
# client adds /v1 or /v2 per endpoint. For example https://api.ustoz.ai
USTOZ_API_BASE_URL=

# Bearer token for the same API. There is no refresh flow, so a 401 means the
# token is wrong or revoked rather than expired mid-run. Both variables must
# be set together: a base URL with no token produces a run of 401s that look
# like an outage rather than a missing setting.
USTOZ_API_TOKEN=

# ---------------------------------------------------------------------------
# Optional: audience accounts. Each one unset skips only its own collector.
# ---------------------------------------------------------------------------

# Which accounts to follow. These gate the collectors: an unset handle records
# the platform as skipped rather than failed, so nothing here breaks a run.
#
# Worth setting before INSTAGRAM_ACCESS_TOKEN below. The token authorises the
# API but this is what switches the collector on, so a deploy carrying only the
# token gets "no handle configured" and never uses it.
#
# Written with or without a leading @; it is stripped either way.
SOCIAL_TELEGRAM_CHANNEL=
SOCIAL_INSTAGRAM_HANDLE=
SOCIAL_YOUTUBE_HANDLE=

# Optional alongside the YouTube handle. With a key the count comes from the
# Data API, without one it is scraped from the channel page. YouTube rounds the
# figure to three significant figures either way, so the key buys reliability
# rather than precision. console.cloud.google.com, YouTube Data API v3.
YOUTUBE_API_KEY=

# ---------------------------------------------------------------------------
# Optional: daily Telegram digest. Skipped cleanly when unset.
# ---------------------------------------------------------------------------

# Instagram, optional but strongly recommended. Without it the collector falls
# back to scraping, which Instagram rate limits from datacenter hosts including
# Vercel, so the number only refreshes when run from a residential connection.
#
# Get one from developers.facebook.com: create an app of type Business, add the
# Instagram product, open "API setup with Instagram business login", and click
# Generate token next to the account. Signing in there is the authorisation, so
# no tester invite and no linked Facebook Page are needed for this API.
#
# Take the token from the App Dashboard, not from a Business Login flow. The
# dashboard issues a 60 day token; the login flow issues a one hour one, which
# looks identical and expires before the next daily refresh can save it.
#
# Scope: instagram_business_basic. Verified against Meta's docs on 2026-08-13:
# followers_count is a public field on the IG User node.
#
# This is a bootstrap only. On first run it is copied into the database, which
# then becomes the source of truth because the token rotates every 60 days.
# Once the row exists this variable can be deleted.
INSTAGRAM_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=
# Add the bot to the group, then read the id from
# https://api.telegram.org/bot<TOKEN>/getUpdates. Group ids are negative.
TELEGRAM_CHAT_ID=

# Department passwords. Each unlocks only that department's dashboard and the
# pages it owns; DASHBOARD_PASSWORD above is the CEO's and unlocks everything.
# Any of these left unset simply disables that department rather than granting
# it something weaker. Changing one signs out that department alone, because
# each role's session is signed under its own password.
DASHBOARD_PASSWORD_MARKETING=
DASHBOARD_PASSWORD_PRODUCT=
DASHBOARD_PASSWORD_IT=
